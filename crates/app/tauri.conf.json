{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Build Doctor",
  "version": "0.1.0",
  "identifier": "app.builddoctor.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Build Doctor",
        "width": 1360,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0d0f12",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
